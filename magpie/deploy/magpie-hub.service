[Unit]
Description=Magpie hub (our Syncthing fork; holds the owner's folder encrypted)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
User=magpie
Group=magpie
ExecStartPre=+/usr/local/sbin/magpie-firewall apply
ExecStart=/opt/magpie/current/syncthing serve --home /var/lib/magpie --no-browser --no-restart
Environment=STNOUPGRADE=1 STNORESTART=1 STGUIADDRESS=127.0.0.1:8385
Restart=always
RestartSec=3
LimitNOFILE=65536
MemoryMax=2G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/magpie
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
